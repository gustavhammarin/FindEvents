<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111827" />
    <meta property="og:site_name" content="FindEvents" />
    <meta property="og:locale" content="sv_SE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@@findevents" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/App.styles.css" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="/_framework/blazor.web.js"></script>
    <script>
        window.restoreScroll = function () {
            var y = sessionStorage.getItem('eventsScroll');
            if (y) {
                sessionStorage.removeItem('eventsScroll');
                requestAnimationFrame(function () { window.scrollTo({ top: +y, behavior: 'instant' }); });
            }
        };
        window.scrollLock = {
            lock: function () { document.documentElement.classList.add('scroll-locked'); },
            unlock: function () { document.documentElement.classList.remove('scroll-locked'); }
        };
    </script>
</body>
</html>
