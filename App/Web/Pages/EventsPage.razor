@page "/evenemang"
@rendermode InteractiveServer
@inject EventService Events
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.AspNetCore.WebUtilities
@using System.Globalization

<PageTitle>Evenemang i Jönköpings län | FindEvents</PageTitle>
<HeadContent>
    <link rel="canonical" href="@(Nav.BaseUri.TrimEnd('/') + "/evenemang")" />
    <meta name="description" content="Se kommande evenemang i Jönköpings län – musik, teater, sport, familjeaktiviteter och mycket mer." />
    <meta name="robots" content="@(_hasActiveFilters ? "noindex, follow" : "index, follow")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@(Nav.BaseUri.TrimEnd('/') + "/evenemang")" />
    <meta property="og:title" content="Evenemang i Jönköpings län | FindEvents" />
    <meta property="og:description" content="Se kommande evenemang i Jönköpings län – musik, teater, sport, familjeaktiviteter och mycket mer." />
    <meta name="twitter:title" content="Evenemang i Jönköpings län | FindEvents" />
    <meta name="twitter:description" content="Se kommande evenemang i Jönköpings län – musik, teater, sport, familjeaktiviteter och mycket mer." />
</HeadContent>

<div class="sticky-filters">
    <div class="site-container">
        <NewEventFilterBar
            Categories="_categories"
            Places="_places"
            EventCount="_events.Count"
            InitialSearch="@_filters.Search"
            InitialCategories="@_filters.Categories"
            InitialPlaces="@_filters.Places"
            InitialDate="@_filters.Date"
            OnFiltersChanged="HandleFiltersChanged"/>
    </div>
</div>

<div class="site-container events-wrapper">
    @if (_loading)
    {
        <div class="events-spinner">
            <svg class="spinner" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle style="opacity:.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path style="opacity:.75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
            </svg>
        </div>
    }
    else
    {
        <div class="events-grid">
            @foreach (var e in _events)
            {
                var hasImg = !string.IsNullOrEmpty(e.ImageUrl)
                                 && !e.ImageUrl.Contains("placeholder")
                                 && e.ImageUrl.StartsWith("http");
                var date = e.StartDate.HasValue
                    ? e.StartDate.Value.ToDateTime(TimeOnly.MinValue).ToString("d MMM", new System.Globalization.CultureInfo("sv-SE"))
                    : null;
                var time = e.StartTime.HasValue ? e.StartTime.Value.ToString("HH:mm") : null;
                var loc = e.Location ?? e.Municipality;

                <a href="/evenemang/@e.Id"
                   class="event-card"
                   onclick="sessionStorage.setItem('eventsScroll',window.scrollY)">
                    <div class="event-card-image">
                        @if (hasImg)
                        {
                            <img src="@e.ImageUrl" alt="@e.Title" loading="lazy"/>
                        }
                        else
                        {
                            <div class="event-card-placeholder">
                                <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                                    <path d="M16 2v4M8 2v4M3 10h18"/>
                                </svg>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(e.Category))
                        {
                            <span class="event-card-category">@e.Category</span>
                        }
                    </div>
                    <div class="event-card-body">
                        <p class="event-card-title">@e.Title</p>
                        <div class="event-card-meta">
                            @if (date is not null)
                            {
                                <div class="event-meta-item">
                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                                        <path d="M16 2v4M8 2v4M3 10h18"/>
                                    </svg>
                                    <span>@date@(time is not null ? $" · {time}" : "")</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(loc))
                            {
                                <div class="event-meta-item">
                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M12 21c-4-4-7-7.5-7-11a7 7 0 0 1 14 0c0 3.5-3 7-7 11z"/>
                                        <circle cx="12" cy="10" r="2"/>
                                    </svg>
                                    <span class="event-meta-location">@loc</span>
                                </div>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>

        @if (_events.Count == 0)
        {
            <p class="no-results">Inga evenemang hittades.</p>
        }

        @if (_nextCursor is not null)
        {
            <button class="load-more-btn" type="button" @onclick="LoadMore" disabled="@_loadingMore">
                @(_loadingMore ? "Laddar..." : "Ladda mer")
            </button>
        }
    }
</div>

@code {
    private const int PageSize = 32;

    private List<MinimalEventDto> _events = [];
    private List<string> _categories = [];
    private List<string> _places = [];
    private EventCursor? _nextCursor;
    private bool _loading = true;
    private bool _loadingMore;

    private NewFilterState _filters = new();
    private int _take = PageSize;

    private bool _hasActiveFilters =>
        !string.IsNullOrEmpty(_filters.Search) || _filters.Categories.Any() ||
        _filters.Places.Any() || !string.IsNullOrEmpty(_filters.Date);

    private string? _pendingUrl;
    private bool _triggerRestore;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);
        string Get(string k) => q.TryGetValue(k, out var v) ? v.ToString() : "";
        List<string> GetList(string k) => q.TryGetValue(k, out var v) ? v.ToArray().ToList() : [];

        _filters = new NewFilterState
        {
            Search = Get("q"),
            Categories = GetList("cat"),
            Places = GetList("plats"),
            Date = Get("datum")
        };

        if (q.TryGetValue("ta", out var taRaw) && int.TryParse(taRaw, out var ta) && ta > 0)
        {
            _take = Math.Min(ta, 200);
            _triggerRestore = true;
        }

        var filters = await Events.GetFiltersAsync();
        _categories = filters.Categories.ToList();
        _places = filters.Places.ToList();

        await LoadEvents(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingUrl is not null)
        {
            var url = _pendingUrl;
            _pendingUrl = null;
            await JS.InvokeVoidAsync("history.replaceState", null, "", url);
        }

        if (_triggerRestore)
        {
            _triggerRestore = false;
            await JS.InvokeVoidAsync("restoreScroll");
        }
    }

    private async Task HandleFiltersChanged(NewFilterState state)
    {
        _filters = state;
        _take = PageSize;
        _pendingUrl = BuildUrl();
        await LoadEvents(false);
    }

    private async Task LoadMore()
    {
        _take += PageSize;
        _pendingUrl = BuildUrl();
        await LoadEvents(true);
    }

    private async Task LoadEvents(bool append)
    {
        if (!append)
        {
            _loading = true;
            _events = [];
        }
        else
        {
            _loadingMore = true;
        }

        var filter = new EventsFilter
        {
            PageSize = append ? PageSize : _take,
            Search = NullIfEmpty(_filters.Search),
            Categories = _filters.Categories,
            Places = _filters.Places,
            StartDate = NullIfEmpty(_filters.Date),
            CursorStartDate = append ? _nextCursor?.StartDate.ToString("yyyy-MM-dd") : null,
            CursorId = append ? _nextCursor?.Id : null,
        };

        var page = await Events.GetEventsAsync(filter);
        if (append)
            _events.AddRange(page.Items);
        else
            _events = page.Items;
        _nextCursor = page.NextCursor;

        _loading = false;
        _loadingMore = false;

        if (!append)
        {
            _pendingUrl ??= BuildUrl();
        }
    }

    private string BuildUrl()
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(_filters.Search)) parts.Add("q=" + Uri.EscapeDataString(_filters.Search));
        if (_filters.Categories.Count > 0)
            _filters.Categories.ForEach(c => parts.Add("cat=" + Uri.EscapeDataString(c)));
        if (_filters.Places.Count > 0) _filters.Places.ForEach(p => parts.Add("plats=" + Uri.EscapeDataString(p)));
        if (!string.IsNullOrEmpty(_filters.Date)) parts.Add("datum=" + _filters.Date);
        parts.Add("ta=" + _take);
        return "/evenemang?" + string.Join("&", parts);
    }

    private static string? NullIfEmpty(string? s) =>
        string.IsNullOrWhiteSpace(s) ? null : s;

}
