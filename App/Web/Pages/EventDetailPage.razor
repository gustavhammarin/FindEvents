@page "/evenemang/{Id}"
@rendermode InteractiveServer
@inject EventService Events
@inject NavigationManager Nav

@if (_event is null)
{
    <PageTitle>Evenemang hittades inte | FindEvents</PageTitle>
    <div class="detail-wrapper">
        <a href="/evenemang" class="detail-back" onclick="if(document.referrer.includes('/evenemang')){history.back();return false;}">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"/>
            </svg>
            Alla evenemang
        </a>
        <p class="detail-not-found">Evenemanget hittades inte.</p>
    </div>
}
else
{
    <PageTitle>@_event.Title | FindEvents</PageTitle>
    <HeadContent>
        <link rel="canonical" href="@_canonicalUrl" />
        <meta name="description" content="@_description" />
        <meta name="robots" content="index, follow" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@_canonicalUrl" />
        <meta property="og:title" content="@_event.Title | FindEvents" />
        <meta property="og:description" content="@_description" />
        @if (_hasImage)
        {
            <meta property="og:image" content="@_event.ImageUrl" />
            <meta name="twitter:image" content="@_event.ImageUrl" />
        }
        <meta name="twitter:title" content="@_event.Title | FindEvents" />
        <meta name="twitter:description" content="@_description" />
        <script type="application/ld+json">@((MarkupString)_jsonLd)</script>
    </HeadContent>

    <div class="detail-wrapper">
        <a href="/evenemang" class="detail-back" onclick="if(document.referrer.includes('/evenemang')){history.back();return false;}">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"/>
            </svg>
            Alla evenemang
        </a>

        <article class="detail-article">
            <div class="detail-image-wrap">
                @if (_hasImage)
                {
                    <img src="@_event.ImageUrl" alt="@_event.Title" class="detail-image" />
                }
                else
                {
                    <div class="detail-image-placeholder">
                        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18"/>
                        </svg>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_event.Category))
                {
                    <span class="detail-category">@_event.Category</span>
                }
            </div>

            <div class="detail-body">
                <h1 class="detail-title">@_event.Title</h1>

                <div class="detail-meta">
                    @if (_dateLabel is not null)
                    {
                        <div class="detail-meta-item">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="18" rx="2"/>
                                <path d="M16 2v4M8 2v4M3 10h18"/>
                            </svg>
                            <span class="detail-date-text">@_dateLabel</span>
                        </div>
                    }
                    @if (_timeLabel is not null)
                    {
                        <div class="detail-meta-item">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>
                            </svg>
                            <span>@_timeLabel</span>
                        </div>
                    }
                    @if (_locationText is not null)
                    {
                        <div class="detail-meta-item">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 21c-4-4-7-7.5-7-11a7 7 0 0 1 14 0c0 3.5-3 7-7 11z"/>
                                <circle cx="12" cy="10" r="2"/>
                            </svg>
                            <span>@_locationText</span>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_event.Description))
                {
                    <hr class="detail-divider" />
                    <p class="detail-description">@_event.Description</p>
                }

                <a href="@_externalLink" target="_blank" rel="noopener noreferrer" class="detail-cta">
                    Gå till evenemang
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <path d="M15 3h6v6"/><path d="M10 14L21 3"/>
                    </svg>
                </a>
            </div>
        </article>

        @if (_similar.Count > 0)
        {
            <section class="similar-section">
                <h2 class="similar-heading">Liknande evenemang</h2>
                <div class="similar-grid">
                    @foreach (var e in _similar)
                    {
                        var hasImg = !string.IsNullOrEmpty(e.ImageUrl)
                            && !e.ImageUrl.Contains("placeholder")
                            && e.ImageUrl.StartsWith("http");
                        var date = e.StartDate.HasValue
                            ? e.StartDate.Value.ToDateTime(TimeOnly.MinValue)
                                .ToString("d MMM", new System.Globalization.CultureInfo("sv-SE"))
                            : null;
                        var loc = e.Location ?? e.Municipality;

                        <a href="/evenemang/@e.Id" class="similar-card">
                            <div class="similar-card-image">
                                @if (hasImg)
                                {
                                    <img src="@e.ImageUrl" alt="@e.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="similar-card-placeholder">
                                        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                                            <path d="M16 2v4M8 2v4M3 10h18"/>
                                        </svg>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(e.Category))
                                {
                                    <span class="similar-card-category">@e.Category</span>
                                }
                            </div>
                            <div class="similar-card-body">
                                <p class="similar-card-title">@e.Title</p>
                                <div class="similar-card-meta">
                                    @if (date is not null)
                                    {
                                        <span>@date</span>
                                    }
                                    @if (!string.IsNullOrEmpty(loc))
                                    {
                                        <span class="similar-card-loc">@loc</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private EventDto? _event;
    private List<MinimalEventDto> _similar = [];
    private bool _hasImage;
    private string? _description;
    private string? _dateLabel;
    private string? _timeLabel;
    private string? _locationText;
    private string _externalLink = "#";
    private string _canonicalUrl = "";
    private string _jsonLd = "{}";

    protected override async Task OnInitializedAsync()
    {
        _event = await Events.GetByIdAsync(Id);
        if (_event is null) return;

        _canonicalUrl = Nav.BaseUri.TrimEnd('/') + "/evenemang/" + Id;
        _similar = await Events.GetSimilarEventsAsync(Id, count: 6);

        _hasImage = !string.IsNullOrEmpty(_event.ImageUrl)
            && !_event.ImageUrl.Contains("placeholder")
            && _event.ImageUrl.StartsWith("http");

        _description = string.IsNullOrEmpty(_event.Description)
            ? null
            : _event.Description.Length > 160
                ? _event.Description[..160] + "…"
                : _event.Description;

        var svSE = new CultureInfo("sv-SE");
        if (_event.StartDate.HasValue)
        {
            var startDt = _event.StartDate.Value.ToDateTime(TimeOnly.MinValue);
            var startStr = startDt.ToString("dddd d MMMM yyyy", svSE);
            if (_event.EndDate.HasValue && _event.EndDate != _event.StartDate)
            {
                _dateLabel = $"{startStr} – {_event.EndDate.Value.ToDateTime(TimeOnly.MinValue).ToString("dddd d MMMM yyyy", svSE)}";
            }
            else
            {
                _dateLabel = startStr;
            }
        }

        if (_event.StartTime.HasValue)
        {
            var startT = _event.StartTime.Value.ToString("HH:mm");
            _timeLabel = _event.EndTime.HasValue
                ? $"{startT} – {_event.EndTime.Value.ToString("HH:mm")}"
                : startT;
        }

        _locationText = _event.Location is not null && _event.Location != _event.Municipality
            ? $"{_event.Location}, {_event.Municipality}"
            : _event.Municipality;

        _externalLink = _event.Link.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? _event.Link
            : $"https://jkpg.com{_event.Link}";

        _jsonLd = BuildJsonLd();
    }

    private string BuildJsonLd()
    {
        if (_event is null) return "{}";

        var svSE = new CultureInfo("sv-SE");
        var startIso = _event.StartDate.HasValue
            ? _event.StartDate.Value.ToDateTime(_event.StartTime ?? TimeOnly.MinValue)
                .ToString("yyyy-MM-ddTHH:mm:sszzz", CultureInfo.InvariantCulture)
            : null;
        var endIso = _event.EndDate.HasValue
            ? _event.EndDate.Value.ToDateTime(_event.EndTime ?? TimeOnly.MinValue)
                .ToString("yyyy-MM-ddTHH:mm:sszzz", CultureInfo.InvariantCulture)
            : null;

        var name = JsonEscape(_event.Title);
        var desc = JsonEscape(_description ?? "");
        var loc = JsonEscape(_event.Location ?? _event.Municipality ?? "");
        var municipality = JsonEscape(_event.Municipality ?? "Jönköping");
        var url = JsonEscape(_canonicalUrl);
        var img = _hasImage ? JsonEscape(_event.ImageUrl ?? "") : "";

        var sb = new System.Text.StringBuilder();
        sb.Append("{\"@context\":\"https://schema.org\",\"@type\":\"Event\"");
        sb.Append($",\"name\":\"{name}\"");
        if (startIso != null) sb.Append($",\"startDate\":\"{startIso}\"");
        if (endIso != null) sb.Append($",\"endDate\":\"{endIso}\"");
        if (!string.IsNullOrEmpty(desc)) sb.Append($",\"description\":\"{desc}\"");
        if (!string.IsNullOrEmpty(img)) sb.Append($",\"image\":\"{img}\"");
        sb.Append($",\"url\":\"{url}\"");
        sb.Append($",\"location\":{{\"@type\":\"Place\",\"name\":\"{(string.IsNullOrEmpty(loc) ? municipality : loc)}\",\"address\":{{\"@type\":\"PostalAddress\",\"addressLocality\":\"{municipality}\",\"addressRegion\":\"Jönköpings län\",\"addressCountry\":\"SE\"}}}}");
        sb.Append(",\"eventStatus\":\"https://schema.org/EventScheduled\"");
        sb.Append(",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\"");
        if (!string.IsNullOrEmpty(_event.Category)) sb.Append($",\"keywords\":\"{JsonEscape(_event.Category)}\"");
        sb.Append(",\"organizer\":{\"@type\":\"Organization\",\"name\":\"FindEvents\",\"url\":\"https://findevents.se\"}");
        sb.Append('}');
        return sb.ToString();
    }

    private static string JsonEscape(string s) =>
        s.Replace("\\", "\\\\").Replace("\"", "\\\"")
         .Replace("\n", "\\n").Replace("\r", "").Replace("\t", "\\t");
}
