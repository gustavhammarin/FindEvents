@model App.Web.Pages.EventCardsViewModel
@{
    Layout = null;
    var svSE = new CultureInfo("sv-SE");
}

@* OOB count only makes sense for HTMX partial responses — on full SSR render
   the count already exists in the sticky filter bar and would duplicate. *@
@if (Context.Request.Headers.ContainsKey("HX-Request"))
{
    <p id="event-count" class="fb-count" hx-swap-oob="true">@Model.Events.Count evenemang</p>
}

<div class="events-grid" id="events-grid" data-take="@Model.Take">
    @foreach (var e in Model.Events)
    {
        var hasImg = !string.IsNullOrEmpty(e.ImageUrl)
            && !e.ImageUrl.Contains("placeholder")
            && e.ImageUrl.StartsWith("http");
        var date = e.StartDate.HasValue
            ? e.StartDate.Value.ToDateTime(TimeOnly.MinValue).ToString("d MMM", svSE)
            : null;
        var time = e.StartTime.HasValue ? e.StartTime.Value.ToString("HH:mm") : null;
        var loc = e.Location ?? e.Municipality;
        <a href="/evenemang/@e.Id" class="event-card">
            <div class="event-card-image">
                @if (hasImg)
                {
                    <img src="@e.ImageUrl" alt="@e.Title" loading="lazy" />
                }
                else
                {
                    <div class="event-card-placeholder">
                        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18"/>
                        </svg>
                    </div>
                }
                @if (!string.IsNullOrEmpty(e.Category))
                {
                    <span class="event-card-category">@e.Category</span>
                }
            </div>
            <div class="event-card-body">
                <p class="event-card-title">@e.Title</p>
                <div class="event-card-meta">
                    @if (date is not null)
                    {
                        <div class="event-meta-item">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="18" rx="2"/>
                                <path d="M16 2v4M8 2v4M3 10h18"/>
                            </svg>
                            <span>@date@(time is not null ? $" · {time}" : "")</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(loc))
                    {
                        <div class="event-meta-item">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 21c-4-4-7-7.5-7-11a7 7 0 0 1 14 0c0 3.5-3 7-7 11z"/>
                                <circle cx="12" cy="10" r="2"/>
                            </svg>
                            <span class="event-meta-location">@loc</span>
                        </div>
                    }
                </div>
            </div>
        </a>
    }
</div>

@if (!Model.Events.Any())
{
    <p class="no-results">Inga evenemang hittades.</p>
}

@if (Model.NextCursor is not null)
{
    <button class="load-more-btn"
            hx-get="/evenemang?handler=Cards"
            hx-target="#events-container"
            hx-swap="innerHTML"
            hx-include="#filters"
            hx-vals="@("{\"ta\": \"" + (Model.Take + 32) + "\"}")">
        Ladda mer
    </button>
}
