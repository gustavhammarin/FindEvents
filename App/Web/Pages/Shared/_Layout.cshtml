<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(ViewData["Title"] ?? "FindEvents – Evenemang i Jönköpings län")</title>
    <meta name="theme-color" content="#faf8f4" />
    <meta property="og:site_name" content="FindEvents" />
    <meta property="og:locale" content="sv_SE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@@findevents" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
    @RenderSection("Head", required: false)
</head>
<body>
    <header class="site-header">
        <div class="site-container">
            <a href="/evenemang" class="site-logo">FindEvents</a>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <script src="/js/htmx.min.js" asp-append-version="true"></script>
    <script src="/js/htmx-filters.js" asp-append-version="true"></script>
</body>
</html>
