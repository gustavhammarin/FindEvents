@implements IDisposable
@inject App.Services.PopupManager PopupManager
@inject IJSRuntime JS

<div class="dd-root @(_open ? "dd-open" : "")">
    @if (_open)
    {
        <div class="dd-backdrop" @onclick="Close"></div>
    }
    <button type="button" class="dd-toggle @(!string.IsNullOrEmpty(Value) ? "dd-active" : "")" @onclick="Toggle">
        <span>@(string.IsNullOrEmpty(Value) ? Placeholder : Value)</span>
        <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
        </svg>
    </button>
    @if (_open)
    {
        <div class="dd-menu" role="listbox">
            @if (!string.IsNullOrEmpty(Value))
            {
                <button type="button" class="dd-option dd-option-reset" role="option" @onclick='() => Select("")'>
                    Alla
                </button>
                <div class="dd-divider"></div>
            }
            @foreach (var opt in Options)
            {
                var selected = opt == Value;
                <button type="button" class="dd-option @(selected ? "dd-option-selected" : "")" role="option" aria-selected="@selected" @onclick="() => Select(opt)">
                    <span>@opt</span>
                    @if (selected)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5"/>
                        </svg>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<string> Options { get; set; } = [];
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Välj...";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private readonly Guid _id = Guid.NewGuid();
    private bool _open;

    protected override void OnInitialized() => PopupManager.OnOpen += HandleOpen;

    private void HandleOpen(Guid id) => InvokeAsync(() =>
    {
        if (id != _id && _open) { _open = false; StateHasChanged(); }
    });

    private async Task Toggle()
    {
        _open = !_open;
        if (_open)
        {
            PopupManager.Open(_id);
            await JS.InvokeVoidAsync("scrollLock.lock");
        }
        else
        {
            await JS.InvokeVoidAsync("scrollLock.unlock");
        }
    }

    private async Task Close()
    {
        _open = false;
        await JS.InvokeVoidAsync("scrollLock.unlock");
    }

    private async Task Select(string val)
    {
        _open = false;
        await JS.InvokeVoidAsync("scrollLock.unlock");
        if (val != Value)
            await ValueChanged.InvokeAsync(val);
    }

    public void Dispose()
    {
        PopupManager.OnOpen -= HandleOpen;
        if (_open)
            JS.InvokeVoidAsync("scrollLock.unlock");
    }
}
