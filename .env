# Elasticsearch/Kibana stack version
STACK_VERSION=8.15.0

# Cluster name
CLUSTER_NAME=docker-cluster

# Passwords (dev only — change for any shared/prod use)
ELASTIC_PASSWORD=changeme123
KIBANA_PASSWORD=kibana456

# License: basic or trial
LICENSE=basic

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme123
POSTGRES_DB=findevents
POSTGRES_PORT=5432

# Ports
ES_PORT=9200
KIBANA_PORT=5601

# Memory limit per container (bytes): 1GB
MEM_LIMIT=1073741824
