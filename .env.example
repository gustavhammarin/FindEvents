# Copy to .env and fill in your own values:  cp .env.example .env
# This single file configures BOTH the app (via DotNetEnv) and docker compose.
# App settings use double underscore: Section__Key maps to Section:Key.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=findevents
POSTGRES_PORT=5432

# --- App: database ---
# Local dev: Host=localhost. Production (docker-compose.prod.yaml): Host=postgres.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=findevents;Username=postgres;Password=<postgres-password>

# --- App: scraper + Mistral ---
Scraper__Enabled=true
MistralSettings__ApiKey=<mistral-api-key>

# --- App: local oMLX fallback (only used when MistralSettings__ApiKey is empty) ---
LlmSettings__Model=<model-id>
LlmSettings__ApiKey=<omlx-api-key>

# --- App: admin page (http://.../admin, user "admin"). Empty = admin disabled. ---
Admin__Password=<admin-password>

# --- App: on-disk cache for proxied event images (/img/{id}) ---
# Local dev: any writable local path. Production: /data/img-cache (mounted volume, see docker-compose.prod.yaml).
ImageCacheSettings__Path=/data/img-cache

# --- Production deploy (docker-compose.prod.yaml) ---
DOMAIN=example.com

# --- pgAdmin (optional, dev only) ---
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=<pgadmin-password>
PGADMIN_PORT=5050
