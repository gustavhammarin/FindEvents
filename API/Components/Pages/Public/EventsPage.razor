@page "/evenemang"
@rendermode InteractiveServer
@using API.Features.Events
@using Application.Core
@using Application.Events.DTOs
@inject GetEventsHandler Handler
@inject AppDbContext Db

<PageTitle>Evenemang – Happening</PageTitle>

@if (_openDropdown != "")
{
    <div class="backdrop" @onclick="CloseDropdowns"></div>
}

<div class="filter-sticky">
    <div class="container">
        <div class="filter-bar">
            <i class="bi bi-search search-icon"></i>
            <input
                class="search-input"
                type="text"
                placeholder="Sök evenemang..."
                value="@_search"
                @oninput="OnSearchInput" />

            <div class="divider"></div>

            <!-- Kategori -->
            <div class="drop-wrap">
                <button class="drop-btn @(_category != "" ? "active" : "")"
                        type="button"
                        @onclick='() => ToggleDropdown("category")'>
                    @(_category == "" ? "Kategori" : _category)
                    <i class="bi bi-chevron-down drop-chevron"></i>
                </button>
                @if (_openDropdown == "category")
                {
                    <div class="drop-list">
                        <button class="drop-item muted @(_category == "" ? "selected" : "")" @onclick='() => Pick("category", "")'>Alla kategorier</button>
                        <div class="drop-sep"></div>
                        @foreach (var cat in _categories)
                        {
                            <button class="drop-item @(_category == cat ? "selected" : "")"
                                    @onclick='() => Pick("category", cat)'>
                                @cat
                                @if (_category == cat) { <i class="bi bi-check"></i> }
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="divider"></div>

            <!-- Kommun -->
            <div class="drop-wrap">
                <button class="drop-btn @(_municipality != "" ? "active" : "")"
                        type="button"
                        @onclick='() => ToggleDropdown("municipality")'>
                    @(_municipality == "" ? "Kommun" : _municipality)
                    <i class="bi bi-chevron-down drop-chevron"></i>
                </button>
                @if (_openDropdown == "municipality")
                {
                    <div class="drop-list">
                        <button class="drop-item muted @(_municipality == "" ? "selected" : "")" @onclick='() => Pick("municipality", "")'>Alla kommuner</button>
                        <div class="drop-sep"></div>
                        @foreach (var mun in _municipalities)
                        {
                            <button class="drop-item @(_municipality == mun ? "selected" : "")"
                                    @onclick='() => Pick("municipality", mun)'>
                                @mun
                                @if (_municipality == mun) { <i class="bi bi-check"></i> }
                            </button>
                        }
                    </div>
                }
            </div>

            @if (_sources.Count > 0)
            {
                <div class="divider"></div>

                <!-- Arrangör -->
                <div class="drop-wrap">
                    <button class="drop-btn @(_source != "" ? "active" : "")"
                            type="button"
                            @onclick='() => ToggleDropdown("source")'>
                        @(_source == "" ? "Arrangör" : SourceLabel(_source))
                        <i class="bi bi-chevron-down drop-chevron"></i>
                    </button>
                    @if (_openDropdown == "source")
                    {
                        <div class="drop-list">
                            <button class="drop-item muted @(_source == "" ? "selected" : "")" @onclick='() => Pick("source", "")'>Alla arrangörer</button>
                            <div class="drop-sep"></div>
                            @foreach (var src in _sources)
                            {
                                <button class="drop-item @(_source == src ? "selected" : "")"
                                        @onclick='() => Pick("source", src)'>
                                    @SourceLabel(src)
                                    @if (_source == src) { <i class="bi bi-check"></i> }
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            <div class="divider"></div>

            <!-- Datum -->
            <div class="drop-wrap">
                <button class="drop-btn @(_startDate.HasValue ? "active" : "")"
                        type="button"
                        @onclick='() => ToggleDropdown("date")'>
                    <i class="bi bi-calendar3" style="margin-right:3px;font-size:0.8rem"></i>
                    @(_startDate.HasValue ? _startDate.Value.ToString("d MMM", _svSE) : "Datum")
                    <i class="bi bi-chevron-down drop-chevron"></i>
                </button>
                @if (_openDropdown == "date")
                {
                    <div class="drop-list cal-drop">
                        <div class="cal-header">
                            <button class="cal-nav" type="button" @onclick="PrevMonth">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <span class="cal-month-label">
                                @_calMonth.ToString("MMMM yyyy", _svSE)
                            </span>
                            <button class="cal-nav" type="button" @onclick="NextMonth">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                        <div class="cal-grid">
                            @foreach (var wd in new[] { "Mån","Tis","Ons","Tor","Fre","Lör","Sön" })
                            {
                                <div class="cal-weekday">@wd</div>
                            }
                            @foreach (var d in GetCalendarDays())
                            {
                                @if (d == null)
                                {
                                    <div class="cal-day empty"></div>
                                }
                                else
                                {
                                    var date = d.Value;
                                    var isSel   = _startDate == date;
                                    var isToday = date == DateOnly.FromDateTime(DateTime.Today);
                                    <button class="cal-day @(isSel ? "selected" : "") @(isToday ? "today" : "")"
                                            type="button"
                                            @onclick="() => SelectDate(date)">
                                        @date.Day
                                    </button>
                                }
                            }
                        </div>
                        @if (_startDate.HasValue)
                        {
                            <div class="cal-footer">
                                <button class="cal-clear" type="button" @onclick="ClearDate">
                                    Rensa datum
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (HasFilters)
            {
                <div class="divider"></div>
                <button class="clear-btn" @onclick="ClearFilters" title="Rensa filter">
                    <i class="bi bi-x"></i>
                </button>
            }
        </div>
    </div>
</div>

<div class="content">
    @if (_loading && _events.Count == 0)
    {
        <div class="grid">
            @for (int i = 0; i < 8; i++)
            {
                <div class="skeleton">
                    <div class="skel-img"></div>
                    <div class="skel-body">
                        <div class="skel-line full"></div>
                        <div class="skel-line two-thirds"></div>
                        <div class="skel-line one-third"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_events.Count == 0 && !_loading)
    {
        <p class="empty">Inga evenemang hittades</p>
    }
    else
    {
        <div class="grid">
            @foreach (var ev in _events)
            {
                <a href="@GetLink(ev)" target="_blank" rel="noopener noreferrer" class="card">
                    <div class="card-img-wrap">
                        @if (HasValidImage(ev))
                        {
                            <img class="card-img" src="@ev.ImageUrl" alt="@ev.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-placeholder">
                                <i class="bi bi-calendar-event"></i>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(ev.Category))
                        {
                            <span class="card-cat">@ev.Category</span>
                        }
                    </div>
                    <div class="card-body">
                        <p class="card-title">@ev.Title</p>
                        <div class="card-meta">
                            @if (ev.StartDate.HasValue)
                            {
                                <div class="meta-row">
                                    <i class="bi bi-calendar3"></i>
                                    <span>@ev.StartDate.Value.ToString("d MMM", _svSE)</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(ev.Location) || !string.IsNullOrEmpty(ev.Municipality))
                            {
                                <div class="meta-row">
                                    <i class="bi bi-geo-alt"></i>
                                    <span class="meta-truncate">@(ev.Location ?? ev.Municipality)</span>
                                </div>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>

        @if (_hasMore)
        {
            <div class="load-more">
                <button class="load-btn" @onclick="LoadMore" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <span>Visa fler</span>
                    }
                </button>
            </div>
        }
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo _svSE = new("sv-SE");

    private static readonly Dictionary<string, string> _sourceLabels = new(StringComparer.OrdinalIgnoreCase)
    {
        ["sv.se"] = "Studieförbundet Vuxenskolan",
    };

    private string _search = "";
    private string _category = "";
    private string _municipality = "";
    private string _source = "";
    private DateOnly? _startDate;
    private DateOnly _calMonth = DateOnly.FromDateTime(DateTime.Today);
    private string _openDropdown = "";

    private List<EventDto> _events = [];
    private List<string> _categories = [];
    private List<string> _municipalities = [];
    private List<string> _sources = [];

    private bool _loading = true;
    private bool _hasMore;
    private EventCursor? _cursor;

    private CancellationTokenSource? _searchCts;

    private bool HasFilters =>
        !string.IsNullOrEmpty(_search) ||
        !string.IsNullOrEmpty(_category) ||
        !string.IsNullOrEmpty(_municipality) ||
        !string.IsNullOrEmpty(_source) ||
        _startDate.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _categories = await Db.Events
            .Select(e => e.Category).Distinct().OrderBy(c => c).ToListAsync();
        _municipalities = await Db.Events
            .Select(e => e.Municipality).Distinct().OrderBy(m => m).ToListAsync();
        _sources = await Db.Events
            .Select(e => e.Source).Distinct().OrderBy(s => s).ToListAsync();

        await FetchAsync(reset: true);
    }

    private void ToggleDropdown(string name) =>
        _openDropdown = _openDropdown == name ? "" : name;

    private void CloseDropdowns() => _openDropdown = "";

    private async Task Pick(string dropdown, string value)
    {
        _openDropdown = "";
        switch (dropdown)
        {
            case "category":     _category     = value; break;
            case "municipality": _municipality = value; break;
            case "source":       _source       = value; break;
        }
        await FetchAsync(reset: true);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _searchCts.Token);
            await FetchAsync(reset: true);
        }
        catch (TaskCanceledException) { }
    }

    private void PrevMonth() => _calMonth = _calMonth.AddMonths(-1);
    private void NextMonth() => _calMonth = _calMonth.AddMonths(1);

    private async Task SelectDate(DateOnly date)
    {
        _startDate = date;
        _openDropdown = "";
        await FetchAsync(reset: true);
    }

    private async Task ClearDate()
    {
        _startDate = null;
        _openDropdown = "";
        await FetchAsync(reset: true);
    }

    private List<DateOnly?> GetCalendarDays()
    {
        var days = new List<DateOnly?>();
        var first = new DateOnly(_calMonth.Year, _calMonth.Month, 1);
        var last  = first.AddMonths(1).AddDays(-1);
        int startDow = ((int)first.DayOfWeek + 6) % 7; // Mon=0
        for (int i = 0; i < startDow; i++) days.Add(null);
        for (int d = 1; d <= last.Day; d++)
            days.Add(new DateOnly(_calMonth.Year, _calMonth.Month, d));
        while (days.Count % 7 != 0) days.Add(null);
        return days;
    }

    private async Task ClearFilters()
    {
        _search = ""; _category = ""; _municipality = ""; _source = ""; _startDate = null;
        await FetchAsync(reset: true);
    }

    private async Task LoadMore() => await FetchAsync(reset: false);

    private async Task FetchAsync(bool reset)
    {
        _loading = true;
        if (reset) { _cursor = null; _events.Clear(); }

        var result = await Handler.HandleAsync(new GetEventsQuery
        {
            Search          = _search,
            Category        = _category,
            Municipality    = _municipality,
            Source          = _source,
            StartDate       = _startDate?.ToString("yyyy-MM-dd"),
            PageSize        = 16,
            CursorStartDate = _cursor?.StartDate.ToString("yyyy-MM-dd"),
            CursorId        = _cursor?.Id,
        });

        _events.AddRange(result.Items);
        _cursor  = result.NextCursor;
        _hasMore = result.NextCursor is not null;
        _loading = false;
    }

    private static string SourceLabel(string source) =>
        _sourceLabels.TryGetValue(source, out var label) ? label : source;

    private static bool HasValidImage(EventDto ev) =>
        !string.IsNullOrEmpty(ev.ImageUrl) &&
        !ev.ImageUrl.Contains("placeholder", StringComparison.OrdinalIgnoreCase) &&
        ev.ImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase);

    private static string GetLink(EventDto ev) =>
        ev.Link.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? ev.Link : $"https://jkpg.com{ev.Link}";
}
