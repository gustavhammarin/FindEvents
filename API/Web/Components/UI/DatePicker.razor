@implements IDisposable

@{
    var selectedDate = DateOnly.TryParse(Value, out var sd) ? (DateOnly?)sd : null;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var displayText = selectedDate.HasValue
        ? selectedDate.Value.ToString("d MMM yyyy", _svSE)
        : "Datum";
}

<div class="dp-root @(_open ? "dp-open" : "")" @onfocusin="CancelClose" @onfocusout="ScheduleClose">
    <button type="button" class="dp-toggle @(selectedDate.HasValue ? "dp-active" : "")" @onclick="Toggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
        </svg>
        <span>@displayText</span>
        @if (selectedDate.HasValue)
        {
            <span class="dp-clear" @onclick="Clear" @onclick:stopPropagation aria-label="Rensa datum">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
            </span>
        }
    </button>

    @if (_open)
    {
        <div class="dp-popup">
            <div class="dp-header">
                <button type="button" class="dp-nav" @onclick="PrevMonth" aria-label="Föregående månad">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="m15 18-6-6 6-6"/>
                    </svg>
                </button>
                <span class="dp-month-label">@_view.ToString("MMMM yyyy", _svSE)</span>
                <button type="button" class="dp-nav" @onclick="NextMonth" aria-label="Nästa månad">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="m9 18 6-6-6-6"/>
                    </svg>
                </button>
            </div>

            <div class="dp-weekdays">
                @foreach (var d in new[] { "M","T","O","T","F","L","S" })
                {
                    <span>@d</span>
                }
            </div>

            <div class="dp-days">
                @{
                    var first = new DateOnly(_view.Year, _view.Month, 1);
                    var offset = ((int)first.DayOfWeek + 6) % 7;
                    var days = DateTime.DaysInMonth(_view.Year, _view.Month);

                    for (var i = 0; i < offset; i++)
                    {
                        <span class="dp-day dp-empty"></span>
                    }
                    for (var d = 1; d <= days; d++)
                    {
                        var date = new DateOnly(_view.Year, _view.Month, d);
                        var past = date < today;
                        var sel = date == selectedDate;
                        var isToday = date == today;
                        var cls = "dp-day" + (past ? " dp-past" : "") + (sel ? " dp-selected" : "") + (isToday && !sel ? " dp-today" : "");
                        var val = date.ToString("yyyy-MM-dd");
                        <button type="button" class="@cls" disabled="@past" @onclick="() => SelectDate(val)">@d</button>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo _svSE = new("sv-SE");

    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private bool _open;
    private DateOnly _view = DateOnly.FromDateTime(DateTime.UtcNow);
    private System.Threading.Timer? _closeTimer;

    private void Toggle() => _open = !_open;
    private void PrevMonth() => _view = _view.AddMonths(-1);
    private void NextMonth() => _view = _view.AddMonths(1);

    private void CancelClose()
    {
        _closeTimer?.Dispose();
        _closeTimer = null;
    }

    private void ScheduleClose()
    {
        _closeTimer?.Dispose();
        _closeTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() => { _open = false; StateHasChanged(); });
        }, null, 200, Timeout.Infinite);
    }

    private async Task SelectDate(string val)
    {
        _open = false;
        CancelClose();
        if (val != Value)
            await ValueChanged.InvokeAsync(val);
    }

    private async Task Clear()
    {
        _open = false;
        CancelClose();
        if (!string.IsNullOrEmpty(Value))
            await ValueChanged.InvokeAsync("");
    }

    public void Dispose() => _closeTimer?.Dispose();
}
