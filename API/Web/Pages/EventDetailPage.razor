@page "/evenemang/{Id}"
@inject AppDbContext Db

@if (_event is null)
{
    <PageTitle>Evenemang hittades inte | FindEvents</PageTitle>
    <div class="detail-wrapper">
        <a href="/evenemang" class="detail-back" onclick="if(document.referrer.includes('/evenemang')){history.back();return false;}">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"/>
            </svg>
            Alla evenemang
        </a>
        <p class="detail-not-found">Evenemanget hittades inte.</p>
    </div>
}
else
{
    <PageTitle>@_event.Title | FindEvents</PageTitle>
    <HeadContent>
        <meta name="description" content="@_description" />
        <meta property="og:title" content="@_event.Title" />
        <meta property="og:description" content="@_description" />
        @if (_hasImage)
        {
            <meta property="og:image" content="@_event.ImageUrl" />
        }
        <meta property="og:type" content="event" />
        <meta name="robots" content="index, follow" />
    </HeadContent>

    <div class="detail-wrapper">
        <a href="/evenemang" class="detail-back" onclick="if(document.referrer.includes('/evenemang')){history.back();return false;}">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"/>
            </svg>
            Alla evenemang
        </a>

        <article class="detail-article">
            <div class="detail-image-wrap">
                @if (_hasImage)
                {
                    <img src="@_event.ImageUrl" alt="@_event.Title" class="detail-image" />
                }
                else
                {
                    <div class="detail-image-placeholder">
                        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18"/>
                        </svg>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_event.Category))
                {
                    <span class="detail-category">@_event.Category</span>
                }
            </div>

            <div class="detail-body">
                <h1 class="detail-title">@_event.Title</h1>

                <div class="detail-meta">
                    @if (_dateLabel is not null)
                    {
                        <div class="detail-meta-item">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="18" rx="2"/>
                                <path d="M16 2v4M8 2v4M3 10h18"/>
                            </svg>
                            <span class="detail-date-text">@_dateLabel</span>
                        </div>
                    }
                    @if (_timeLabel is not null)
                    {
                        <div class="detail-meta-item">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>
                            </svg>
                            <span>@_timeLabel</span>
                        </div>
                    }
                    @if (_locationText is not null)
                    {
                        <div class="detail-meta-item">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 21c-4-4-7-7.5-7-11a7 7 0 0 1 14 0c0 3.5-3 7-7 11z"/>
                                <circle cx="12" cy="10" r="2"/>
                            </svg>
                            <span>@_locationText</span>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_event.Description))
                {
                    <hr class="detail-divider" />
                    <p class="detail-description">@_event.Description</p>
                }

                <a href="@_externalLink" target="_blank" rel="noopener noreferrer" class="detail-cta">
                    Gå till evenemang
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <path d="M15 3h6v6"/><path d="M10 14L21 3"/>
                    </svg>
                </a>
            </div>
        </article>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private Event? _event;
    private bool _hasImage;
    private string? _description;
    private string? _dateLabel;
    private string? _timeLabel;
    private string? _locationText;
    private string _externalLink = "#";

    protected override async Task OnInitializedAsync()
    {
        _event = await Db.Events.AsNoTracking().FirstOrDefaultAsync(e => e.Id == Id);
        if (_event is null) return;

        _hasImage = !string.IsNullOrEmpty(_event.ImageUrl)
            && !_event.ImageUrl.Contains("placeholder")
            && _event.ImageUrl.StartsWith("http");

        _description = string.IsNullOrEmpty(_event.Description)
            ? null
            : _event.Description.Length > 160
                ? _event.Description[..160] + "…"
                : _event.Description;

        var svSE = new CultureInfo("sv-SE");
        if (_event.StartDate.HasValue)
        {
            var startDt = new DateTime(_event.StartDate.Value.Year, _event.StartDate.Value.Month, _event.StartDate.Value.Day);
            var startStr = startDt.ToString("dddd d MMMM yyyy", svSE);
            if (_event.EndDate.HasValue && _event.EndDate != _event.StartDate)
            {
                var endDt = new DateTime(_event.EndDate.Value.Year, _event.EndDate.Value.Month, _event.EndDate.Value.Day);
                _dateLabel = $"{startStr} – {endDt.ToString("dddd d MMMM yyyy", svSE)}";
            }
            else
            {
                _dateLabel = startStr;
            }
        }

        if (_event.StartTime.HasValue)
        {
            var startT = _event.StartTime.Value.ToString("HH:mm");
            _timeLabel = _event.EndTime.HasValue
                ? $"{startT} – {_event.EndTime.Value.ToString("HH:mm")}"
                : startT;
        }

        _locationText = _event.Location is not null
            ? _event.Location == _event.Municipality
                ? _event.Municipality
                : $"{_event.Location}, {_event.Municipality}"
            : _event.Municipality;

        _externalLink = _event.Link?.StartsWith("http") == true
            ? _event.Link
            : $"https://jkpg.com{_event.Link}";
    }
}
