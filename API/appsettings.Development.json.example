{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ElasticSettings": {
    "Url": "https://localhost:9200",
    "DefaultIndex": "events",
    "Password": "<elastic-password>"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=findevents;Username=postgres;Password=<postgres-password>"
  },
  "Scraper": {
    "Enabled": true
  },
  "LlmSettings": {
    "BaseUrl": "http://127.0.0.1:8000/v1",
    "Model": "<model-id>",
    "ApiKey": "<omlx-api-key>"
  }
}
