{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=findevents;Username=postgres;Password=<postgres-password>"
  },
  "Scraper": {
    "Enabled": true
  },
  "MistralSettings": {
    "BaseUrl": "https://api.mistral.ai/v1",
    "Model": "mistral-small-2506",
    "ApiKey": "<mistral-api-key>"
  },
  "LlmSettings": {
    "BaseUrl": "http://127.0.0.1:8000/v1",
    "Model": "<model-id>",
    "ApiKey": "<omlx-api-key>"
  }
}
